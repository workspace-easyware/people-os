{
  "name": "DOCX 편집 노드 시험",
  "description": "docx_edit 노드 + 승인 게이트",
  "definition": {
    "version": 1,
    "steps": [
      {
        "id": "s1", "type": "docx_edit", "name": "Word 편집 (승인 뒤)", "requiresApproval": true,
        "config": {
          "docId": "{{input.docId}}",
          "title": "워크플로 Word 편집본",
          "ops": [
            { "op": "replace", "find": "홍길동", "to": "{{input.newName}}", "all": true },
            { "op": "cell", "table": 1, "r": 1, "c": 2, "text": "28" },
            { "op": "insert", "after": 6, "text": "워크플로가 넣은 문단 ({{input.newName}})" }
          ]
        }
      },
      { "id": "s2", "type": "create_task", "name": "확인 할 일", "config": { "title": "Word 편집본 확인: {{steps.s1.output.title}} ({{steps.s1.output.docId}})" } }
    ]
  }
}
