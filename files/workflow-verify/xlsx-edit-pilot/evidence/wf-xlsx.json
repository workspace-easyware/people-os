{
  "name": "XLSX 편집 노드 시험",
  "description": "xlsx_edit 노드 + 승인 게이트 (로컬)",
  "definition": {
    "version": 1,
    "steps": [
      {
        "id": "s1", "type": "xlsx_edit", "name": "엑셀 편집 (승인 뒤)", "requiresApproval": true,
        "config": {
          "docId": "{{input.docId}}",
          "title": "워크플로 엑셀 편집본",
          "ops": [
            { "op": "cell", "sheet": "요약", "cell": "B5", "value": 31 },
            { "op": "formula", "sheet": "요약", "cell": "B6", "formula": "SUM(B4:B5)", "result": 55 },
            { "op": "row", "sheet": "데이터", "values": ["{{input.coach}}", "온보딩", 3] }
          ]
        }
      },
      { "id": "s2", "type": "create_task", "name": "확인 할 일", "config": { "title": "엑셀 편집본 확인: {{steps.s1.output.title}} ({{steps.s1.output.docId}})" } }
    ]
  }
}
